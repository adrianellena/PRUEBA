# URL del servidor ntfy. Usá https://ntfy.sh (público) o tu propio servidor
# self-hosted si preferís no depender de un servicio de terceros.
NTFY_URL=https://ntfy.sh

# Topic "secreto": cualquiera que conozca este nombre puede leer tus alertas
# en ntfy.sh, así que generá algo largo y aleatorio, NO uses palabras comunes.
# Ejemplo para generar uno: openssl rand -hex 16
NTFY_TOPIC=CAMBIAR-por-un-topic-secreto-y-aleatorio

# Usuarios de Ubuntu a vigilar, separados por coma.
WATCHED_USERS=cristian,margarita,adrian

# Opcional: autenticación básica, solo si tu servidor ntfy self-hosted la exige.
#NTFY_BASIC_USER=
#NTFY_BASIC_PASS=
